# HospitalChain Environment Variables
# Copy this file to .env in each service directory (backend, frontend, blockchain)
# or set these variables in your shell before running the application

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy to: backend/.env

# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospitalchain?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Blockchain Configuration (Hardhat/Ethereum)
BLOCKCHAIN_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOOD_BAG_CONTRACT_ADDRESS=

# Temperature Monitoring
TEMP_MIN=2
TEMP_MAX=6

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy to: frontend/.env
# Note: Vite uses VITE_ prefix for environment variables

VITE_API_URL=http://localhost:4000
VITE_BLOCKCHAIN_URL=http://localhost:8545
VITE_NODE_ENV=development

# ============================================
# BLOCKCHAIN ENVIRONMENT VARIABLES
# ============================================
# Copy to: blockchain/.env
# Hardhat configuration is in hardhat.config.ts

# No additional variables needed for basic Hardhat setup
# The hardhat.config.ts already has the local network configuration

# ============================================
# DOCKER ENVIRONMENT VARIABLES
# ============================================
# These are automatically set in docker-compose.yml
# But you can override them here if needed

# For Docker development:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hospitalchain?schema=public
# BLOCKCHAIN_URL=http://blockchain:8545

# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# For production deployments, use these settings:

# Backend (production)
# NODE_ENV=production
# PORT=4000
# DATABASE_URL=postgresql://user:password@host:5432/hospitalchain?schema=public
# JWT_SECRET=your-very-secure-production-secret
# BLOCKCHAIN_URL=https://your-blockchain-provider.com
# BLOCKCHAIN_CHAIN_ID=1
# FRONTEND_URL=https://your-frontend-domain.com

# Frontend (production)
# VITE_API_URL=https://your-api-domain.com
# VITE_BLOCKCHAIN_URL=https://your-blockchain-domain.com
# VITE_NODE_ENV=production

# ============================================
# DEMO CREDENTIALS
# ============================================
# After running the seed script (./scripts/seed.sh), you can use:
# Admin: admin@hospitalchain.com / admin123
# Hemocentro: user@hemocentro.sp.gov.br / hemocentro123
# Hospital A: user@hospitala.sp.gov.br / hospitala123
# Hospital B: user@hospitalb.sp.gov.br / hospitalb123
# Auditor: auditor@saude.gov.br / auditor123
